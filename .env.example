NODE_ENV=development
PORT=3001

# Prisma / PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bridge?schema=public"

# CORS: exact origin of the Next.js frontend (no trailing slash)
FRONTEND_ORIGIN="http://localhost:3000"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-a-strong-random-string-of-at-least-32-chars"
JWT_REFRESH_SECRET="replace-me-with-another-strong-random-string-of-32-plus-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Seed script — creates the first admin agent on `pnpm db:seed` if none exists
SEED_ADMIN_EMAIL="admin@bridge.local"
SEED_ADMIN_PASSWORD="ChangeMeNow!123"
SEED_ADMIN_NAME="Admin"
