// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
}

enum UserStatus {
  ONLINE
  AWAY
  OFFLINE
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  // Stable Google-issued user id (`sub` in the ID token). Preferred key
  // for lookup / linking; email can change but `sub` never does.
  googleSub     String     @unique
  email         String     @unique
  name          String
  phone         String?
  photoUrl      String?
  role          UserRole   @default(MEMBER)
  status        UserStatus @default(OFFLINE)
  // Every user is created unapproved on first Google sign-in. An admin
  // must flip this to true (via DB or a future admin console) before the
  // account can access anything past /access-restricted.
  isApproved    Boolean    @default(false)
  lastSeenAt    DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens         RefreshToken[]
  channelAssignments    UserChannel[]  @relation("ChannelMember")
  assignedChannelsBy    UserChannel[]  @relation("ChannelAssignedBy")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]      @relation("MessageAuthor")

  @@index([role, isApproved, deactivatedAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdByIp  String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum ChannelType {
  INSTAGRAM
  WHATSAPP
  EMAIL
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
}

model Channel {
  id                    String        @id @default(uuid()) @db.Uuid
  type                  ChannelType
  // Display name is what admins see everywhere in the app. Enforced
  // globally unique so two channels can't share a label regardless of
  // their type (Instagram vs Email vs WhatsApp).
  displayName           String        @unique
  externalId            String?
  credentialsEncrypted  String?
  // Non-secret, human-readable identifier for the connected account.
  // For EMAIL channels this is the SMTP username. Displayed in the
  // "connection summary" view so admins can see which mailbox is wired
  // up without exposing the encrypted credentials blob.
  mailboxAddress        String?
  // Timestamp of the most recent successful OTP verification. Powers
  // the "Last verified X ago" indicator; null means never (or the
  // channel's credentials were rotated since the last verify).
  credentialsVerifiedAt DateTime?
  status                ChannelStatus @default(CONNECTED)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  contacts      Contact[]
  assignments   UserChannel[]
  conversations Conversation[]
  otpChallenges EmailChallenge[]

  @@unique([type, externalId])
  @@index([type, status])
}

// One-time-password challenge used by the "Test connection" flow: the
// backend sends an OTP FROM the connected mailbox TO the admin's Bridge
// email, and the admin pastes the received code back to prove SMTP
// delivery works end-to-end. Codes are stored hashed and expire fast.
model EmailChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   String    @db.Uuid
  sentToEmail String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([channelId, verifiedAt])
  @@index([expiresAt])
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId  String   @db.Uuid
  externalId String
  name       String?
  avatarUrl  String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conversations Conversation[]

  @@unique([channelId, externalId])
  @@index([channelId, updatedAt])
}

model UserChannel {
  user             User     @relation("ChannelMember", fields: [userId], references: [id], onDelete: Cascade)
  userId           String   @db.Uuid
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId        String   @db.Uuid
  assignedBy       User     @relation("ChannelAssignedBy", fields: [assignedByUserId], references: [id])
  assignedByUserId String   @db.Uuid
  createdAt        DateTime @default(now())

  @@id([userId, channelId])
  @@index([channelId])
  @@index([userId])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STORY_REPLY
  REACTION
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id                    String             @id @default(uuid()) @db.Uuid
  channel               Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId             String             @db.Uuid
  contact               Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId             String             @db.Uuid
  status                ConversationStatus @default(OPEN)
  assignedUser          User?              @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedUserId        String?            @db.Uuid
  lastMessageAt         DateTime           @default(now())
  lastCustomerMessageAt DateTime?
  unreadCount           Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  messages Message[]

  @@unique([channelId, contactId])
  @@index([status, lastMessageAt])
  @@index([assignedUserId, status, lastMessageAt])
  @@index([channelId, lastMessageAt])
}

model Message {
  id                String                @id @default(uuid()) @db.Uuid
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String                @db.Uuid
  direction         MessageDirection
  authorType        MessageAuthorType
  authorUser        User?                 @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorUserId      String?               @db.Uuid
  externalId        String?               @unique
  type              MessageType           @default(TEXT)
  text              String?
  mediaUrl          String?
  mediaMimeType     String?
  replyToMessageId  String?               @db.Uuid
  deliveryStatus    MessageDeliveryStatus @default(SENT)
  errorReason       String?
  // Server-internal per-message extras (email subject, provider ids, etc.).
  // Not exposed in MessageResponse; used only by adapters/services.
  metadata          Json                  @default("{}")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([conversationId, direction, createdAt])
}
