// Prisma schema — bridge-be
// Redesigned schema: 5 tables only.
//   User, Channel, Ticket, EmailMessage, TicketActivityLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- Enums ---------------------------------------------------------------

enum UserRole {
  MEMBER
  ADMIN
  BOT
}

enum UserStatus {
  ONLINE
  AWAY
  OFFLINE
}

enum ChannelType {
  INSTAGRAM
  WHATSAPP
  EMAIL
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
}

enum TicketStatus {
  OPEN
  IN_FOLLOWUP
  WAITING
  RESOLVED
}

enum MessageDirection {
  SENT
  RECEIVED
}

enum TicketActivity {
  CREATED
  ASSIGNED_TO_BOT
  ASSIGNED_TO_AGENT
  REASSIGNED_TO_AGENT
  PUT_INTO_FOLLOWUP
  PUT_INTO_WAITING
  MARKED_RESOLVED
  REOPENED
  NOTES_ADDED
  SENT_BACK_TO_QUEUE
}

// ---- Models --------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  googleSub     String?    @unique
  email         String?    @unique
  name          String
  phone         String?
  photoUrl      String?
  role          UserRole   @default(MEMBER)
  status        UserStatus @default(OFFLINE)
  isApproved    Boolean    @default(false)
  lastSeenAt    DateTime?
  deactivatedAt DateTime?
  // Refresh token lives inline instead of in a separate table. One
  // active session per user — logging in on device B invalidates
  // whatever refresh token device A was holding. Fine for a CRM.
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  assignedTickets Ticket[] @relation("TicketAssignee")

  @@index([role, isApproved, deactivatedAt])
}

model Channel {
  id                    String        @id @default(uuid()) @db.Uuid
  type                  ChannelType
  displayName           String        @unique
  inbox_contact         String?
  credentials_encrypted String?
  credentialsVerifiedAt DateTime?
  status                ChannelStatus @default(DISCONNECTED)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tickets       Ticket[]
  emailMessages EmailMessage[]
}

model Ticket {
  id             BigInt       @id @default(autoincrement())
  channel        Channel      @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  channel_id     String       @db.Uuid
  channel_type   ChannelType
  assigneeUser   User         @relation("TicketAssignee", fields: [assignee], references: [id])
  assignee       String       @db.Uuid
  status         TicketStatus
  is_reopened    Boolean      @default(false)
  refund_related Boolean      @default(false)
  thread_key     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  emailMessages EmailMessage[]
  activityLogs  TicketActivityLog[]

  @@unique([channel_id, thread_key])
  @@index([assignee, status])
  @@index([status, updatedAt])
}

model EmailMessage {
  id                  String           @id @default(uuid()) @db.Uuid
  channel             Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId           String           @db.Uuid
  subject             String?
  type                MessageDirection
  content             String
  sender              String?
  receiver            String[]
  ticket              Ticket           @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  ticket_id           BigInt
  external_message_id String           @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  @@index([channelId, createdAt])
  @@index([ticket_id, createdAt])
}

model TicketActivityLog {
  id        String         @id @default(uuid()) @db.Uuid
  ticket    Ticket         @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  ticket_id BigInt
  event     TicketActivity
  log       String?
  createdAt DateTime       @default(now())

  @@index([ticket_id, createdAt])
}
