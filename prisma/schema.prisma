// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AgentRole {
  AGENT
  ADMIN
}

enum AgentStatus {
  ONLINE
  AWAY
  OFFLINE
}

model Agent {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         AgentRole   @default(AGENT)
  status       AgentStatus @default(OFFLINE)
  lastSeenAt   DateTime?
  deactivatedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshTokens       RefreshToken[]
  sentInvitations     Invitation[]    @relation("InvitedBy")
  channelAssignments  AgentChannel[]  @relation("ChannelMember")
  assignedChannelsBy  AgentChannel[]  @relation("ChannelAssignedBy")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages        Message[]       @relation("MessageAuthor")

  @@index([role, deactivatedAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdByIp  String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([agentId, revokedAt])
  @@index([expiresAt])
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  role        AgentRole @default(AGENT)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedBy   Agent     @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById String    @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([email, acceptedAt, revokedAt])
  @@index([expiresAt])
}

enum ChannelType {
  INSTAGRAM
  WHATSAPP
  EMAIL
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
}

model Channel {
  id                    String        @id @default(uuid()) @db.Uuid
  type                  ChannelType
  displayName           String
  externalId            String?
  credentialsEncrypted  String?
  status                ChannelStatus @default(CONNECTED)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  contacts      Contact[]
  assignments   AgentChannel[]
  conversations Conversation[]

  @@unique([type, externalId])
  @@index([type, status])
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId  String   @db.Uuid
  externalId String
  name       String?
  avatarUrl  String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conversations Conversation[]

  @@unique([channelId, externalId])
  @@index([channelId, updatedAt])
}

model AgentChannel {
  agent            Agent    @relation("ChannelMember", fields: [agentId], references: [id], onDelete: Cascade)
  agentId          String   @db.Uuid
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId        String   @db.Uuid
  assignedBy       Agent    @relation("ChannelAssignedBy", fields: [assignedByAgentId], references: [id])
  assignedByAgentId String  @db.Uuid
  createdAt        DateTime @default(now())

  @@id([agentId, channelId])
  @@index([channelId])
  @@index([agentId])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STORY_REPLY
  REACTION
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id                    String             @id @default(uuid()) @db.Uuid
  channel               Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId             String             @db.Uuid
  contact               Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId             String             @db.Uuid
  status                ConversationStatus @default(OPEN)
  assignedAgent         Agent?             @relation("ConversationAssignee", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedAgentId       String?            @db.Uuid
  lastMessageAt         DateTime           @default(now())
  lastCustomerMessageAt DateTime?
  unreadCount           Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  messages Message[]

  @@unique([channelId, contactId])
  @@index([status, lastMessageAt])
  @@index([assignedAgentId, status, lastMessageAt])
  @@index([channelId, lastMessageAt])
}

model Message {
  id                String                @id @default(uuid()) @db.Uuid
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String                @db.Uuid
  direction         MessageDirection
  authorType        MessageAuthorType
  authorAgent       Agent?                @relation("MessageAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  authorAgentId     String?               @db.Uuid
  externalId        String?               @unique
  type              MessageType           @default(TEXT)
  text              String?
  mediaUrl          String?
  mediaMimeType     String?
  replyToMessageId  String?               @db.Uuid
  deliveryStatus    MessageDeliveryStatus @default(SENT)
  errorReason       String?
  // Server-internal per-message extras (email subject, provider ids, etc.).
  // Not exposed in MessageResponse; used only by adapters/services.
  metadata          Json                  @default("{}")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([conversationId, direction, createdAt])
}
